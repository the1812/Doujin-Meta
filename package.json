{
  "name": "doujin-meta",
  "version": "1.0.0",
  "private": true,
  "description": "A metadata database for doujin music.",
  "keywords": [
    "database",
    "metadata",
    "music"
  ],
  "license": "MIT",
  "author": "Grant Howard",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp check && vp build",
    "start": "node .output/server/index.mjs",
    "album:id": "node scripts/generate-album-id.mjs"
  },
  "dependencies": {
    "@primeuix/themes": "1.0.0",
    "axios": "1.8.2",
    "dompurify": "3.2.4",
    "nitro": "3.0.260610-beta",
    "primeicons": "7.0.0",
    "primevue": "4.3.1",
    "valibot": "1.4.2",
    "vue": "3.5.13",
    "vue-i18n": "11.4.10",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@the1812/oxc-config": "1.0.0",
    "@types/node": "22.13.9",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.3",
    "tailwindcss": "3",
    "typescript": "5.8.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b",
  "pnpm": {
    "overrides": {
      "caniuse-lite": "1.0.30001702",
      "vite@*": "npm:@voidzero-dev/vite-plus-core@0.3.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ],
      "allowedVersions": {
        "vite": "*"
      }
    }
  }
}
