{
  "cSpell.words": [
    "caniuse",
    "dompurify",
    "doujin",
    "ilike",
    "inputtext",
    "intlify",
    "kysely",
    "plainto",
    "previewicon",
    "primeicons",
    "primeuix",
    "primevue",
    "progressspinner",
    "Touhou",
    "tsquery",
    "tsvector",
    "oxfmt",
    "oxlint",
    "unplugin",
    "websearch"
  ],
  "cSpell.ignorePaths": [
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".git/objects",
    ".vscode",
    ".vscode-insiders",
    "metadata.json"
  ],
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "oxc.typeAware": true,
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
